# MySQL 连接串（本地默认 root/root）
DATABASE_URL="mysql://root:root@localhost:3306/yihu_finance"
# JWT 签名密钥，生产环境务必替换
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3010
UPLOAD_DIR="./uploads"
# 录入助手：设为 1 时不请求平台大模型，按关键词返回预置的工具调用序列（本地 / CI 端到端测试用）
# 不设 = 生产行为：用 YH_API_URL + YH_CLIENT_ID/YH_CLIENT_SECRET 调以虎 One 平台大模型，没接入平台时助手入口置灰
# FIN_LLM_STUB=1
# 可选：指定平台大模型名称，不设由平台决定
# FIN_LLM_MODEL=
